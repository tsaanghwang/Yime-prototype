{
  "schema_version": 1,
  "policy_id": "tier5_two_level_runtime_v2",
  "purpose": "Keep complete source evidence while materializing a compact two-level runtime lexicon.",
  "character_boundary": {
    "maximum_tier": 5,
    "expected_distinct_characters": 14000
  },
  "first_level": {
    "maximum_text_length": 4,
    "capacity_base": 202290,
    "included_source_lengths": {
      "pypinyin": [2, 3, 4]
    },
    "included_wanxiang_category_lengths": {
      "duoyin": [2, 3],
      "fangyan": [2, 3],
      "huaxue": [2, 3],
      "jichu": [2, 3],
      "shici": [2, 3],
      "wuzhong": [2, 3],
      "yaopin": [2, 3]
    }
  },
  "second_level": {
    "minimum_text_length": 5,
    "frequency_cache_capacity": 5000,
    "retain_selected_long_bridges": true
  },
  "long_form_core_migration": {
    "minimum_text_length": 5,
    "eligible_candidate_classes": [
      "lexical_candidate",
      "productive_phrase"
    ],
    "protected_candidate_classes": [
      "domain_term",
      "place_name",
      "person_name"
    ],
    "required_evidence": {
      "bcc_frequency": 0,
      "dependent_reading_count": 0,
      "mandatory_static": false,
      "all_readings_dynamically_recoverable": true
    },
    "action": "exclude_from_static_core_keep_dynamic_recoverable",
    "source_mutation": false,
    "noise_label": false,
    "selected_runtime_violation_limit": 0
  },
  "dynamic_coverage_gate": {
    "policy": "internal_data/dynamic_candidate_coverage_policy.json",
    "require_complete": true
  },
  "candidate_ranking_evidence_gate": {
    "policy": "internal_data/candidate_ranking_evidence_policy.json",
    "require_complete": true
  },
  "safety": {
    "require_formal_existing_encoding": true,
    "preserve_full_source_database": true,
    "filter_materialized_runtime_only": true,
    "unmatched_selected_readings_are_errors": true
  },
  "evaluation": {
    "fixed_replay_cases": 5830,
    "scoped_production_top_cases": 2449,
    "observed_cold_top1": 2440,
    "observed_cold_top1_rate": 0.9963250306247448,
    "wilson_95_lower_bound": 0.9930300811292823
  },
  "runtime_handoff": {
    "default_schema": "yime_core_trial",
    "windows_dictionary": "go-backend/input_methods/yime/data/yime_core_trial.dict.yaml",
    "windows_profile": "go-backend/input_methods/yime/data/yime_runtime_profile.json",
    "legacy_large_lexicons_role": [
      "source_of_truth",
      "candidate_screening_pool",
      "regression_test_resource"
    ],
    "legacy_large_lexicons_packaged": false
  }
}
